  <name>BlastEm</name>
  <developer id="com.retrodev">
    <name>Michael Pavone</name>
  </developer>
  <summary>Emulator for Sega 8-bit and 16-bit systems</summary>
  <description>
    <p>
      BlastEm emulates the Sega Genesis and Mega Drive, Sega and Mega CD,
      32X, Master System and Mark III, Game Gear, SG-1000, and SC-3000
      systems.
    </p>
    <p>
      It provides a graphical game browser, configurable controllers, save
      states, debugging facilities, and OpenGL shaders. Users supply their own
      legally obtained game software and any optional firmware.
    </p>
  </description>
  <launchable type="desktop-id">com.retrodev.BlastEm.desktop</launchable>
